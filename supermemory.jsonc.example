{
  // Memory layer for opus-free: agent recalls from memory instead of
  // re-sending full history every turn. Pick ONE backend:
  //
  // A) Cloud (easiest, free tier): get a key at https://supermemory.ai,
  //    then:  bunx opencode-supermemory@latest login
  //    (or paste it as "apiKey" below)
  //
  // "apiKey": "sm_...",
  //
  // B) Local server (private, needs an embedding provider key):
  //    supermemory-server  (listens on http://localhost:6767)
  //    with one of OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY /
  //    GROQ_API_KEY set (Groq + Gemini have free tiers).
  //
  // "baseUrl": "http://localhost:6767",
  // "apiKey": "sm_...",

  "recallMode": "direct",
  "captureEveryNTurns": 3
}
